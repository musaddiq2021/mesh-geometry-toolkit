# Standalone cross-platform CLI acceptance checks. SCRATCH belongs to build tree.
if(NOT TOOL OR NOT SOURCE OR NOT SCRATCH)
    message(FATAL_ERROR "TOOL, SOURCE and SCRATCH are required")
endif()
file(MAKE_DIRECTORY "${SCRATCH}")
function(run expected)
    execute_process(COMMAND "${TOOL}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI ${ARGN}: expected exit ${expected}, got ${result}\n${output}\n${error}")
    endif()
    set(LAST_OUTPUT "${output}" PARENT_SCOPE)
    set(LAST_ERROR "${error}" PARENT_SCOPE)
endfunction()
function(expect text)
    string(REPLACE "\r\n" "\n" normalized "${LAST_OUTPUT}")
    string(FIND "\n${normalized}" "\n${text}\n" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${text}' in:\n${LAST_OUTPUT}")
    endif()
endfunction()
function(expect_contains text)
    string(FIND "${LAST_OUTPUT}" "${text}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing '${text}' in:\n${LAST_OUTPUT}")
    endif()
endfunction()

run(0 --version)
expect("Mesh Geometry Toolkit 1.0.0")
run(0 --help)
expect_contains("strictly convex")
run(0 inspect "${SOURCE}/examples/cube.obj")
expect("Vertices: 8")
expect("Triangles: 12")
expect("Surface area: 6")
expect("Enclosed volume: 1")
expect("Width: 1")
expect("Height: 1")
expect("Depth: 1")
set(cube_report "${LAST_OUTPUT}")
run(0 convert "${SOURCE}/examples/cube.obj" "${SCRATCH}/round trip.obj")
run(0 inspect "${SCRATCH}/round trip.obj")
if(NOT LAST_OUTPUT STREQUAL cube_report)
    message(FATAL_ERROR "File round trip changed cube metrics")
endif()
run(0 inspect "${SOURCE}/examples/tetrahedron.obj")
expect_contains("Enclosed volume: 0.166666")
run(0 inspect "${SOURCE}/examples/concave_solid.obj")
expect("Surface area: 14")
expect("Enclosed volume: 3")
run(0 inspect "${SOURCE}/examples/open_square.obj")
expect("Surface area: 6")
expect("Width: 2")
expect("Height: 3")
expect("Depth: 0")
expect_contains("Enclosed volume: unavailable")
expect_contains("Mesh is open")
run(0 inspect "${SOURCE}/examples/inconsistent_cube.obj")
expect("Surface area: 6")
expect_contains("Enclosed volume: unavailable")
expect_contains("winding is inconsistent")
file(WRITE "${SCRATCH}/empty.obj" "# empty mesh\n")
run(0 inspect "${SCRATCH}/empty.obj")
expect("Surface area: 0")
expect("Bounds: empty")
expect_contains("Enclosed volume: unavailable")
run(1 inspect "${SOURCE}/tests/fixtures/invalid.obj")
if(NOT LAST_ERROR MATCHES "OBJ line 4")
    message(FATAL_ERROR "Invalid OBJ diagnostic lost its source line")
endif()
run(1 inspect "${SOURCE}/tests/fixtures/concave.obj")
file(READ "${SOURCE}/examples/cube.obj" cube_source)
string(ASCII 26 ctrl_z)
file(WRITE "${SCRATCH}/ctrl-z.obj" "${cube_source}\n${ctrl_z}\nunsupported_geometry 1\n")
run(1 inspect "${SCRATCH}/ctrl-z.obj")
if(NOT LAST_ERROR MATCHES "Unsupported OBJ record")
    message(FATAL_ERROR "Ctrl-Z hid malformed trailing OBJ records")
endif()
run(1 inspect "${SCRATCH}/nonexistent.obj")
string(ASCII 27 escape)
run(1 inspect "${SCRATCH}/bad${escape}[31m.obj")
string(FIND "${LAST_ERROR}" "${escape}" escape_position)
if(NOT escape_position EQUAL -1)
    message(FATAL_ERROR "Filename diagnostic emitted a terminal control sequence")
endif()
run(2)
run(2 inspect)
run(2 unsupported)
file(WRITE "${SCRATCH}/preserve.obj" "preserve existing output")
run(1 convert "${SOURCE}/tests/fixtures/invalid.obj" "${SCRATCH}/preserve.obj")
file(READ "${SCRATCH}/preserve.obj" preserved)
if(NOT preserved STREQUAL "preserve existing output")
    message(FATAL_ERROR "Invalid conversion modified destination")
endif()
run(1 convert "${SOURCE}/examples/cube.obj" "${SCRATCH}/missing/output.obj")
# Successful replacement is intentional; same-file conversion is never allowed.
file(WRITE "${SCRATCH}/existing.obj" "old contents")
run(0 convert "${SOURCE}/examples/cube.obj" "${SCRATCH}/existing.obj")
run(0 inspect "${SCRATCH}/existing.obj")
expect("Enclosed volume: 1")
file(WRITE "${SCRATCH}/input.obj" "${cube_source}")
file(SHA256 "${SCRATCH}/input.obj" before)
run(1 convert "${SCRATCH}/input.obj" "${SCRATCH}/input.obj")
run(1 convert "${SCRATCH}/input.obj" "${SCRATCH}/./input.obj")
file(CREATE_LINK "${SCRATCH}/input.obj" "${SCRATCH}/hardlink.obj" RESULT link_result)
if(link_result STREQUAL "0")
    run(1 convert "${SCRATCH}/input.obj" "${SCRATCH}/hardlink.obj")
else()
    message(STATUS "Hard-link alias check unavailable on this filesystem")
endif()
file(SHA256 "${SCRATCH}/input.obj" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Same-file conversion modified its input")
endif()
file(MAKE_DIRECTORY "${SCRATCH}/directory-output")
file(WRITE "${SCRATCH}/directory-output/preserve.txt" "preserve")
run(1 convert "${SOURCE}/examples/cube.obj" "${SCRATCH}/directory-output")
file(READ "${SCRATCH}/directory-output/preserve.txt" preserved)
if(NOT preserved STREQUAL "preserve")
    message(FATAL_ERROR "Failed replacement modified destination directory")
endif()
file(GLOB staged_files "${SCRATCH}/.mesh-output-*.tmp")
if(staged_files)
    message(FATAL_ERROR "Temporary OBJ output leaked after failed replacement")
endif()
message(STATUS "CLI acceptance checks passed")
